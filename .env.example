# Copy to .env.local and fill in (never commit .env.local).
# Supabase → Project Settings → Data API / API Keys.

# Safe in the browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never share it, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public address of the site, used in QR codes on the home page (no trailing slash).
# On Vercel it falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=https://realityfood.example
